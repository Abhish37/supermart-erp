# ==========================================
# SUPERMART ERP & POS ENVIRONMENT CONFIG TEMPLATE
# ==========================================

# GITHUB
GITHUB_REPO_URL="https://github.com/your-username/supermart-erp"
GITHUB_ACCESS_TOKEN=""

# VERCEL
VERCEL_TOKEN=""
VERCEL_ORG_ID=""
VERCEL_PROJECT_ID=""

# RENDER
RENDER_API_KEY=""
RENDER_OWNER_ID=""

# POSTGRESQL
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
INTERNAL_DATABASE_URL="postgresql://user:password@internal-host:5432/dbname"

# REDIS
REDIS_URL="rediss://user:password@host:6379"
INTERNAL_REDIS_URL="redis://internal-host:6379"
UPSTASH_REDIS_REST_TOKEN=""

# SYSTEM THRESHOLDS & WORKFLOW
SCAN_DEBOUNCE_WINDOW_MS=800
PEAK_DAY_BUFFER_START=1
PEAK_DAY_BUFFER_END=10
DEAD_STOCK_THRESHOLD_DAYS=20

# WHATSAPP (V2 / MOCK)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_TOKEN=""
OWNER_PHONE_NUMBER="+919876543210"

# PORTS & ENDPOINTS
PORT=8000
BACKEND_URL="http://localhost:8000"
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_WS_URL="ws://localhost:8000/ws"
